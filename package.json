{
  "name": "lcn-code",
  "version": "1.0.0",
  "description": "a code agent",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "format": "prettier --write .",
    "build": "node scripts/clean.mjs dist && tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "verify": "prettier --check . && npm test && npm run build",
    "test": "node scripts/clean.mjs .build/test && tsc -p tsconfig.test.json && cd .build/test && node --test"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "prettier": "^3.9.7",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/StarMeteoritePavilion/lcn-code.git"
  },
  "bugs": {
    "url": "https://github.com/StarMeteoritePavilion/lcn-code/issues"
  },
  "homepage": "https://github.com/StarMeteoritePavilion/lcn-code#readme",
  "packageManager": "npm@10.9.9",
  "private": true
}
